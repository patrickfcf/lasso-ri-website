---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, type Locale } from '../content/site';
import { pagePath } from '../lib/site.mjs';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<BaseLayout locale={locale} title={t.title} description={t.description}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 id="hero-title">{t.headline}</h1>
      <p class="hero-intro">{t.intro}</p>
      <div class="hero-actions">
        <a class="button" href="#app">
          {t.cta}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={pagePath(locale, 'roadmap')}>
          {t.secondary}
        </a>
      </div>
    </div>
    <figure class="brand-art">
      <picture>
        <source
          srcset="/assets/lasso-icon-dark.png"
          media="(prefers-color-scheme: dark)"
        />
        <img
          src="/assets/lasso-icon.png"
          width="1024"
          height="1024"
          alt={t.artwork}
          fetchpriority="high"
        />
      </picture>
    </figure>
  </section>
  <aside class="status wrap" aria-labelledby="status-title">
    <h2 id="status-title">{t.statusTitle}</h2>
    <p>{t.status}</p>
  </aside>
  <section
    id="app"
    class="features wrap section"
    aria-labelledby="features-title"
  >
    <h2 id="features-title">{t.featureTitle}</h2>
    <p class="section-intro">{t.featureIntro}</p>
    <div class="feature-grid">
      {t.features.map(([title, body, label]) => (
        <article class="feature">
          <span class="feature-label">{label}</span>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="platform-section" aria-labelledby="platform-title">
    <div class="wrap section">
      <h2 id="platform-title">{t.platformTitle}</h2>
      <p class="section-intro">{t.platformText}</p>
      <ul class="platforms">
        {t.platforms.map((platform) => (
          <li>{platform}</li>
        ))}
      </ul>
      <p class="note">{t.platformNote}</p>
    </div>
  </section>
  <section class="privacy-section wrap section" aria-labelledby="privacy-title">
    <h2 id="privacy-title">{t.privacyTitle}</h2>
    <div>
      <p>{t.privacyText}</p>
      <a class="text-link" href={pagePath(locale, 'privacy')}>
        {t.privacyLink}
        <span aria-hidden="true"> ↗</span>
      </a>
    </div>
  </section>
  <section class="faq wrap section" aria-labelledby="faq-title">
    <h2 id="faq-title">{t.faqTitle}</h2>
    <div class="faq-list">
      {t.faqs.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
